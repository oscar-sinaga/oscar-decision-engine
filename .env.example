# Local development only. Copy to .env (gitignored), then generate strong values.
# Generate example: python -c "import secrets; print(secrets.token_hex(32))"
# Use URL-safe ASCII for the PostgreSQL password (it is embedded in a DSN).
OSCAR_POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_HEX
OSCAR_JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
OSCAR_ENVIRONMENT=development
# Explicitly opt in to synthetic user/policy data for a fresh local database:
OSCAR_ENABLE_DEMO_SEED=false
# Only used when the seed is enabled:
OSCAR_SEED_PASSWORD=REPLACE_WITH_DEMO_ONLY_PASSWORD
OSCAR_DEBUG=false
OSCAR_LOG_LEVEL=INFO
OSCAR_LOG_JSON=true
